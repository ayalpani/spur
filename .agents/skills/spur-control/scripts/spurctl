#!/usr/bin/env bash
set -euo pipefail

readonly DEVICE_MODEL="SM_A546B"
readonly DEVICE_IP="192.168.178.162"
readonly ADB_CONNECT_SERVICE="adb-R5CWA1MD0GD-8swK1E"
readonly PACKAGE="app.spur"
readonly LEGACY_PACKAGE="app.spur.debug"
readonly ACTIVITY="app.spur/.MainActivity"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

resolve_project_root() {
    local candidate
    if candidate="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)" &&
        [[ -f "$candidate/.agents/skills/spur-control/SKILL.md" ]]
    then
        printf '%s\n' "$candidate"
        return
    fi

    cd "$SCRIPT_DIR/../../../.." && pwd
}

readonly PROJECT_ROOT="$(resolve_project_root)"
readonly APK="$PROJECT_ROOT/app/build/outputs/apk/debug/app-debug.apk"

find_adb() {
    local candidate
    for candidate in \
        "${ANDROID_HOME:-}/platform-tools/adb" \
        "${ANDROID_SDK_ROOT:-}/platform-tools/adb" \
        "/Users/ayalpani/Library/Android/sdk/platform-tools/adb"
    do
        if [[ -x "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return
        fi
    done

    command -v adb || {
        echo "ADB wurde nicht gefunden." >&2
        exit 1
    }
}

readonly ADB="$(find_adb)"

online_serial() {
    "$ADB" devices -l |
        awk -v model="$DEVICE_MODEL" '$2 == "device" && $0 ~ "model:" model { print $1; exit }'
}

dns_sd_endpoint() {
    local lookup_file lookup_pid port attempt
    command -v dns-sd >/dev/null 2>&1 || return 1
    lookup_file="$(mktemp -t spur-adb-mdns.XXXXXX)"
    dns-sd -L "$ADB_CONNECT_SERVICE" _adb-tls-connect._tcp local. \
        >"$lookup_file" 2>/dev/null &
    lookup_pid=$!
    port=""
    for attempt in {1..30}; do
        port="$(
            sed -nE 's/.*can be reached at .*:([0-9]+) .*/\1/p' "$lookup_file" |
                head -n 1
        )"
        [[ -n "$port" ]] && break
        sleep 0.1
    done
    kill "$lookup_pid" >/dev/null 2>&1 || true
    wait "$lookup_pid" >/dev/null 2>&1 || true
    rm -f "$lookup_file"
    [[ -n "$port" ]] || return 1
    printf '%s:%s\n' "$DEVICE_IP" "$port"
}

connect_device() {
    local serial service endpoint
    serial="$(online_serial)"
    if [[ -n "$serial" ]]; then
        printf '%s\n' "$serial"
        return
    fi

    if [[ -n "${SPUR_ADB_ENDPOINT:-}" ]]; then
        "$ADB" connect "$SPUR_ADB_ENDPOINT" >/dev/null 2>&1 || true
        serial="$(online_serial)"
        if [[ -n "$serial" ]]; then
            printf '%s\n' "$serial"
            return
        fi
    fi

    while read -r service; do
        [[ -n "$service" ]] || continue
        "$ADB" connect "$service" >/dev/null 2>&1 || true
        serial="$(online_serial)"
        if [[ -n "$serial" ]]; then
            printf '%s\n' "$serial"
            return
        fi
    done < <("$ADB" mdns services 2>/dev/null | awk '/_adb-tls-connect/ { print $3 }')

    endpoint="$(dns_sd_endpoint || true)"
    if [[ -n "$endpoint" ]]; then
        "$ADB" connect "$endpoint" >/dev/null 2>&1 || true
        serial="$(online_serial)"
        if [[ -n "$serial" ]]; then
            printf '%s\n' "$serial"
            return
        fi
    fi

    echo "Galaxy A54 nicht erreichbar. WLAN-Debugging am Handy einschalten." >&2
    exit 1
}

build() {
    echo "Baue Spur aus $PROJECT_ROOT." >&2
    (cd "$PROJECT_ROOT" && ./gradlew :app:assembleDebug)
}

install() {
    local serial output
    build >&2
    serial="$(connect_device)"

    if "$ADB" -s "$serial" shell pm path "$LEGACY_PACKAGE" >/dev/null 2>&1; then
        echo "Legacy-Paket $LEGACY_PACKAGE bleibt zum Schutz lokaler Daten installiert." >&2
    fi

    if output="$("$ADB" -s "$serial" install -r "$APK" 2>&1)"; then
        printf '%s\n' "$serial"
        return
    fi

    if [[ "$output" == *"INSTALL_FAILED_UPDATE_INCOMPATIBLE"* ]]; then
        printf '%s\n' "$output" >&2
        echo "Abbruch: Signaturkonflikt. $PACKAGE wird nicht deinstalliert; lokale Daten bleiben unangetastet." >&2
        exit 1
    fi

    printf '%s\n' "$output" >&2
    exit 1
}

launch() {
    local serial
    serial="$(connect_device)"
    "$ADB" -s "$serial" shell am start -W -n "$ACTIVITY"
}

stop() {
    local serial
    serial="$(connect_device)"
    "$ADB" -s "$serial" shell am force-stop "$PACKAGE"
    echo "Spur gestoppt auf $serial."
}

status() {
    local serial
    serial="$(connect_device)"
    echo "Gerät: $serial ($DEVICE_MODEL)"
    if "$ADB" -s "$serial" shell pm path "$PACKAGE" >/dev/null 2>&1; then
        echo "Installation: vorhanden"
    else
        echo "Installation: fehlt"
    fi
    if "$ADB" -s "$serial" shell pidof "$PACKAGE" >/dev/null 2>&1; then
        echo "Status: läuft"
    else
        echo "Status: gestoppt"
    fi
}

case "${1:-}" in
    build)
        build
        ;;
    install)
        serial="$(install)"
        echo "Spur installiert auf $serial."
        ;;
    start)
        serial="$(install)"
        "$ADB" -s "$serial" shell am force-stop "$PACKAGE"
        "$ADB" -s "$serial" shell am start -W -n "$ACTIVITY"
        ;;
    launch)
        launch
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        launch
        ;;
    status)
        status
        ;;
    *)
        echo "Verwendung: scripts/spurctl {start|build|install|launch|stop|restart|status}" >&2
        exit 2
        ;;
esac
